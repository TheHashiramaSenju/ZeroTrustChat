import { Router } from 'express';
import AuthService from '../../../services/AuthService.js';
import { validateRequest, Schemas } from '../../../middleware/validateRequest.js';
import jwt from 'jsonwebtoken';
import { User, AuditLog } from '../../../models/index.js';

const router = Router();

// --- Register a new user ---
router.post('/register', validateRequest(Schemas.auth.register), async (req, res, next) => {
    try {
        const { email, password } = req.body;
        const { error } = await AuthService.register(email, password);

        if (error) {
            if (error.message.includes('User already registered')) {
                return res.status(409).json({ error: 'A user with this email already exists.' });
            }
            return res.status(400).json({ error: error.message });
        }

        res.status(201).json({ message: 'Registration successful. Please check your email to verify.' });
    } catch (err) {
        next(err);
    }
});

// --- Log in a user ---
// Replace the existing login route with this enhanced version:
import AccountLockoutService from '../../../services/AccountLockoutService.js';

router.post('/login', validateRequest(Schemas.auth.login), async (req, res, next) => {
    try {
        const { email, password } = req.body;
        const ipAddress = req.ip;
        const userAgent = req.headers['user-agent'];

        // Step 1: Check if account is locked
        const { isLocked, lockedUntil } = await AccountLockoutService.isAccountLocked(email);

        if (isLocked) {
            const secondsRemaining = AccountLockoutService.getTimeUntilUnlock(lockedUntil);
            const minutesRemaining = Math.ceil(secondsRemaining / 60);

            return res.status(403).json({
                error: `Account is temporarily locked due to too many failed login attempts. Try again in ${minutesRemaining} minutes.`,
                lockedUntil: lockedUntil.toISOString(),
            });
        }

        // Step 2: Attempt login
        const { session, error } = await AuthService.login(email, password);

        if (error) {
            // Record failed attempt
            const { locked, attemptsRemaining } = await AccountLockoutService.recordFailedAttempt(
                email,
                ipAddress,
                userAgent
            );

            await AuditLog.create({
                action: 'LOGIN_FAILED',
                ipAddress,
                userAgent,
                metadata: { email, attemptsRemaining },
                severity: 'warning',
            });

            if (locked) {
                return res.status(403).json({
                    error: 'Account locked due to too many failed attempts. Try again in 15 minutes.',
                });
            }

            return res.status(401).json({
                error: `Invalid credentials. ${attemptsRemaining} attempt(s) remaining before account lockout.`,
            });
        }

        // Step 3: Successful login - reset lockout counter
        await AccountLockoutService.resetFailedAttempts(email);

        const user = await User.findByPk(session.user.id);

        // Step 4: Check if MFA is enabled
        if (user.mfaEnabled) {
            const mfaToken = jwt.sign(
                { userId: user.id, email: user.email, mfaRequired: true },
                config.JWT_SECRET,
                { expiresIn: '5m' }
            );

            return res.status(200).json({
                message: 'MFA required',
                mfaRequired: true,
                mfaToken,
            });
        }

        // Step 5: Normal login flow (no MFA)
        const { accessToken, refreshToken } = AuthService.generateTokens(session.user);

        res.cookie('refreshToken', refreshToken, {
            httpOnly: true,
            secure: process.env.NODE_ENV === 'production',
            sameSite: 'strict',
            maxAge: 7 * 24 * 60 * 60 * 1000,
        });

        // Update last login timestamp
        user.lastLoginAt = new Date();
        await user.save();

        await AuditLog.create({
            userId: user.id,
            action: 'LOGIN_SUCCESS',
            ipAddress,
            userAgent,
            severity: 'info',
        });

        logger.info(`User ${user.email} logged in successfully from ${ipAddress}`);

        res.status(200).json({
            message: "Login successful",
            accessToken,
            user: {
                id: session.user.id,
                email: session.user.email,
                role: user.role,
            },
        });
    } catch (err) {
        next(err);
    }
});

import OAuthService from '../../../services/OAuthService.js';
import DeviceTrustService from '../../../services/DeviceTrustService.js';
import { Op } from 'sequelize';

/**
 * POST /api/v1/auth/oauth/callback
 * Handle OAuth callback from frontend (after Google login)
 */
router.post('/oauth/callback', async (req, res, next) => {
    try {
        const { accessToken: supabaseAccessToken } = req.body;

        if (!supabaseAccessToken) {
            return res.status(400).json({ error: 'Access token is required' });
        }

        // Get user info from Supabase using the token
        const { data: { user: supabaseUser }, error } = await supabase.auth.getUser(supabaseAccessToken);

        if (error || !supabaseUser) {
            logger.error('OAuth callback failed:', error);
            return res.status(401).json({ error: 'Invalid OAuth token' });
        }

        // Generate device fingerprint
        const fingerprint = DeviceTrustService.generateFingerprint(req);

        // Create or update user in our database
        const user = await OAuthService.handleOAuthUser(supabaseUser, {
            fingerprint,
            ip: req.ip,
            userAgent: req.headers['user-agent'],
        });

        // Generate our own JWT tokens
        const { accessToken, refreshToken } = AuthService.generateTokens({
            id: user.id,
            email: user.email,
            role: user.role,
        });

        // Set refresh token cookie
        res.cookie('refreshToken', refreshToken, {
            httpOnly: true,
            secure: process.env.NODE_ENV === 'production',
            sameSite: 'strict',
            maxAge: 7 * 24 * 60 * 60 * 1000,
        });

        // Audit log
        await AuditLog.create({
            userId: user.id,
            action: 'OAUTH_LOGIN',
            ipAddress: req.ip,
            userAgent: req.headers['user-agent'],
            metadata: { provider: user.oauthProvider },
            severity: 'info',
        });

        res.status(200).json({
            message: 'OAuth login successful',
            accessToken,
            user: {
                id: user.id,
                email: user.email,
                role: user.role,
                avatarUrl: user.avatarUrl,
            },
        });
    } catch (err) {
        next(err);
    }
});


// --- Refresh Access Token ---
router.post('/refresh', async (req, res) => {
    const refreshToken = req.cookies.refreshToken;
    if (!refreshToken) {
        return res.status(401).json({ error: 'No refresh token provided.' });
    }
    
    const { accessToken, error } = await AuthService.refreshAccessToken(refreshToken);

    if (error) {
        return res.status(403).json({ error: 'Invalid refresh token.' });
    }
    
    res.status(200).json({ accessToken });
});


export default router;
