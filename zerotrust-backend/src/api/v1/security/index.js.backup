/**
 * POST /api/v1/security/mfa/verify
 * Verify a TOTP code (used during login)
 */
router.post('/mfa/verify', authenticateToken, async (req, res, next) => {
    try {
        const userId = req.user.userId;
        const { code } = req.body;

        if (!code) {
            return res.status(400).json({ error: 'Code required' });
        }

        const valid = await MFAService.verifyCode(userId, code);

        if (valid) {
            res.status(200).json({ message: 'Code verified' });
        } else {
            res.status(401).json({ error: 'Invalid code' });
        }
    } catch (err) {
        next(err);
    }
});

/**
 * DELETE /api/v1/security/mfa/disable
 * Disable MFA for the current user
 */
router.delete('/mfa/disable', authenticateToken, async (req, res, next) => {
    try {
        const userId = req.user.userId;

        await MFAService.disableMFA(userId);

        await AuditLog.create({
            userId,
            action: 'MFA_DISABLED',
            ipAddress: req.ip,
            userAgent: req.headers['user-agent'],
            severity: 'warning',
        });

        res.status(200).json({ message: 'MFA disabled' });
    } catch (err) {
        next(err);
    }
});


export default router;
