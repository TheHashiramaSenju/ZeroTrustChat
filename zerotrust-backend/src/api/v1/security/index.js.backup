            userId,
            action: 'MFA_ENABLED',
            ipAddress: req.ip,
            userAgent: req.headers['user-agent'],
            severity: 'info',
        });

        logger.info(`MFA enabled for user ${userId}`);

        res.json({ 
            message: 'MFA enabled successfully',
            backupCodes 
