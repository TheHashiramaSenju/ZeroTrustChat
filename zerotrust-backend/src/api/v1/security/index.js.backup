import { Router } from 'express';
import { Session, AuditLog } from '../../../models/index.js';
import authenticateToken from '../../../middleware/authenticateToken.js';
import authorizeRole from '../../../middleware/authorizeRole.js';
import DeviceTrustService from '../../../services/DeviceTrustService.js';
import RiskEngineService from '../../../services/RiskEngineService.js';
import logger from '../../../utils/logger.js';
import { Op } from 'sequelize';


const router = Router();

/**
 * GET /api/v1/security/sessions
 * List all active sessions for the current user
 */
router.get('/sessions', authenticateToken, async (req, res, next) => {
    try {
        const userId = req.user.userId;

        const sessions = await Session.findAll({
            where: { userId, isActive: true },
            order: [['lastActiveAt', 'DESC']],
        });

        const sessionData = sessions.map(s => ({
            id: s.id,
            deviceFingerprint: s.deviceFingerprint,
            ipAddress: s.ipAddress,
            userAgent: s.userAgent,
            location: s.location,
            trustScore: s.trustScore,
            lastActive: s.lastActiveAt,
            createdAt: s.createdAt,
        }));

        res.status(200).json({ sessions: sessionData });
    } catch (err) {
        next(err);
    }
});

/**
 * DELETE /api/v1/security/sessions/:sessionId
 * Revoke a specific session (logout from a device)
 */
router.delete('/sessions/:sessionId', authenticateToken, async (req, res, next) => {
    try {
        const { sessionId } = req.params;
        const userId = req.user.userId;

        const session = await Session.findByPk(sessionId);
        if (!session) {
            return res.status(404).json({ error: 'Session not found' });
        }

        if (session.userId !== userId) {
            return res.status(403).json({ error: 'Not authorized' });
        }

        session.isActive = false;
        await session.save();

        await AuditLog.create({
            userId,
            action: 'SESSION_REVOKED',
            resource: `session:${sessionId}`,
            ipAddress: req.ip,
            userAgent: req.headers['user-agent'],
            severity: 'warning',
        });

        logger.info(`Session ${sessionId} revoked for user ${userId}`);

        res.status(200).json({ message: 'Session revoked successfully' });
    } catch (err) {
        next(err);
    }
});

/**
 * POST /api/v1/security/logout-all
 * Revoke all sessions for the current user (emergency logout)
 */
router.post('/logout-all', authenticateToken, async (req, res, next) => {
    try {
        const userId = req.user.userId;

        await DeviceTrustService.revokeAllDevices(userId);

        await AuditLog.create({
            userId,
            action: 'ALL_SESSIONS_REVOKED',
            ipAddress: req.ip,
            userAgent: req.headers['user-agent'],
            severity: 'critical',
        });

        logger.warn(`All sessions revoked for user ${userId}`);

        res.status(200).json({ message: 'All sessions revoked. Please log in again.' });
    } catch (err) {
        next(err);
    }
});

/**
 * GET /api/v1/security/risk-score
 * Get the current user's risk score
 */
router.get('/risk-score', authenticateToken, async (req, res, next) => {
    try {
        const userId = req.user.userId;
        const fingerprint = req.headers['x-device-fingerprint'] || DeviceTrustService.generateFingerprint(req);

        const riskScore = await RiskEngineService.calculateRiskScore(userId, {
            deviceFingerprint: fingerprint,
            ip: req.ip,
            time: new Date(),
        });

        const evaluation = RiskEngineService.evaluateAccess(riskScore);

        res.status(200).json({
            riskScore,
            status: evaluation.reason,
            allowed: evaluation.allowed,
        });
    } catch (err) {
        next(err);
    }
});

/**
 * GET /api/v1/security/audit-logs
 * Get audit logs for the current user (admin can see all)
 */
router.get('/audit-logs', authenticateToken, async (req, res, next) => {
    try {
        const userId = req.user.userId;
        const isAdmin = req.user.role === 'admin';
        const page = parseInt(req.query.page) || 1;
        const limit = parseInt(req.query.limit) || 50;
        const offset = (page - 1) * limit;

        const where = isAdmin ? {} : { userId };

        const logs = await AuditLog.findAll({
            where,
            order: [['createdAt', 'DESC']],
            limit,
            offset,
        });

        res.status(200).json({
            logs: logs.map(log => ({
                id: log.id,
                action: log.action,
                resource: log.resource,
                ipAddress: log.ipAddress,
                userAgent: log.userAgent,
                metadata: log.metadata,
                severity: log.severity,
                timestamp: log.createdAt,
            })),
            page,
        });
    } catch (err) {
        next(err);
    }
});

/**
 * GET /api/v1/security/status
 * System-wide security health check (admin only)
 */
router.get('/status', authenticateToken, authorizeRole(['admin']), async (req, res, next) => {
    try {
        const activeSessions = await Session.count({ where: { isActive: true } });
        const criticalAlerts = await AuditLog.count({ where: { severity: 'critical' } });
        const recentFailedLogins = await AuditLog.count({
            where: {
                action: 'LOGIN_FAILED',
                createdAt: { [Op.gte]: new Date(Date.now() - 60 * 60 * 1000) },
            },
        });

        res.status(200).json({
            status: 'operational',
            metrics: {
                activeSessions,
                criticalAlerts,
                recentFailedLogins,
            },
            timestamp: new Date().toISOString(),
        });
    } catch (err) {
        next(err);
    }
});

import AccountLockoutService from '../../../services/AccountLockoutService.js';

/**
 * POST /api/v1/security/unlock-account
 * Manually unlock a locked user account (Admin only)
 */
router.post('/unlock-account', authenticateToken, authorizeRole(['admin']), async (req, res, next) => {
    try {
        const { email } = req.body;

        if (!email) {
            return res.status(400).json({ error: 'Email is required' });
        }

        await AccountLockoutService.unlockAccount(email);

        await AuditLog.create({
            userId: req.user.userId,
            action: 'ADMIN_UNLOCK_ACCOUNT',
            ipAddress: req.ip,
            userAgent: req.headers['user-agent'],
            metadata: { targetEmail: email },
            severity: 'warning',
        });

        res.status(200).json({ message: `Account ${email} has been unlocked` });
    } catch (err) {
        next(err);
    }
});


import MFAService from '../../../services/MFAService.js';

/**
 * POST /api/v1/security/mfa/setup
 * Generate a new MFA secret and QR code
 */
router.post('/mfa/setup', authenticateToken, async (req, res, next) => {
    try {
        const userId = req.user.userId;
        const email = req.user.email;

        const { secret, qrCodeUrl } = await MFAService.generateSecret(userId, email);

        res.status(200).json({
            message: 'Scan this QR code with Google Authenticator',
            secret, // Also return secret for manual entry
            qrCodeUrl,
        });
    } catch (err) {
        next(err);
    }
});

/**
 * POST /api/v1/security/mfa/enable
 * Enable MFA after user verifies the initial code
 */
router.post('/mfa/enable', authenticateToken, async (req, res, next) => {
    try {
        const userId = req.user.userId;
        const { token } = req.body;

